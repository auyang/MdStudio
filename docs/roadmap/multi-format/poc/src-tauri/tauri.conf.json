{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MdStudio OFD POC",
  "version": "0.0.0",
  "identifier": "com.mdstudio.ofd-poc",
  "build": {
    "devUrl": "http://127.0.0.1:4179",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "MdStudio OFD POC",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' asset:; img-src 'self' data: blob:; font-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": { "active": true, "targets": ["app"] }
}
